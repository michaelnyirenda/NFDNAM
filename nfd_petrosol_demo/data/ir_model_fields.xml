    <record id="field_x_nfd_fuel_dispatch_log_x_temp_allowance_liters" model="ir.model.fields">
        <field name="name">x_temp_allowance_liters</field>
        <field name="field_description">Thermal Variance Allowance (L)</field>
        <field name="model_id" ref="model_x_nfd_fuel_dispatch_log"/>
        <field name="ttype">float</field>
        <field name="state">manual</field>
        <field name="store">True</field>
        <field name="depends">x_depot_loaded_liters</field>
        <field name="compute">for record in self:
    if record.x_depot_loaded_liters:
        record['x_temp_allowance_liters'] = round(record.x_depot_loaded_liters * 0.0025, 2)
    else:
        record['x_temp_allowance_liters'] = 0.0</field>
    </record>

    <record id="field_x_nfd_fuel_dispatch_log_x_net_variance_liters" model="ir.model.fields">
        <field name="name">x_net_variance_liters</field>
        <field name="field_description">Net Discrepancy / Variance (L)</field>
        <field name="model_id" ref="model_x_nfd_fuel_dispatch_log"/>
        <field name="ttype">float</field>
        <field name="state">manual</field>
        <field name="store">True</field>
        <field name="depends">x_depot_loaded_liters,x_truck_meter_delivered_liters,x_temp_allowance_liters</field>
        <field name="compute">for record in self:
    loaded = record.x_depot_loaded_liters or 0.0
    delivered = record.x_truck_meter_delivered_liters or 0.0
    allowance = record.x_temp_allowance_liters or 0.0
    if loaded and delivered:
        record['x_net_variance_liters'] = round(loaded - delivered - allowance, 2)
    else:
        record['x_net_variance_liters'] = 0.0</field>
    </record>

    <record id="field_x_nfd_fuel_dispatch_log_x_leakage_status" model="ir.model.fields">
        <field name="name">x_leakage_status</field>
        <field name="field_description">Reconciliation Status</field>
        <field name="model_id" ref="model_x_nfd_fuel_dispatch_log"/>
        <field name="ttype">selection</field>
        <field name="state">manual</field>
        <field name="store">True</field>
        <field name="depends">x_net_variance_liters</field>
        <field name="compute">for record in self:
    variance = record.x_net_variance_liters or 0.0
    if variance > 50.0:
        record['x_leakage_status'] = 'leakage_alert'
    elif variance > 10.0:
        record['x_leakage_status'] = 'minor_variance'
    else:
        record['x_leakage_status'] = 'normal'</field>
    </record>
