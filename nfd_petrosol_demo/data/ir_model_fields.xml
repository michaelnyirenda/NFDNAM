    <record id="field_hr_employee_x_hse_compliant" model="ir.model.fields">
        <field name="name">x_hse_compliant</field>
        <field name="field_description">HESMS Compliant</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="ttype">boolean</field>
        <field name="state">manual</field>
        <field name="store">True</field>
        <field name="depends">x_hazchem_expiry,x_defensive_driving_expiry,x_medical_fitness_expiry</field>
        <field name="compute">today = datetime.date.today()
for record in self:
