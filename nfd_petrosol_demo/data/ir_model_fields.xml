    <record id="field_fleet_vehicle_x_vehicle_age" model="ir.model.fields">
        <field name="name">x_vehicle_age</field>
        <field name="field_description">Vehicle Age (Years)</field>
        <field name="model_id" ref="fleet.model_fleet_vehicle"/>
        <field name="ttype">integer</field>
        <field name="state">manual</field>
        <field name="store">True</field>
        <field name="depends">x_manufacture_year</field>
        <field name="compute">current_year = datetime.date.today().year
for record in self:
    if record.x_manufacture_year:
        record['x_vehicle_age'] = max(0, current_year - record.x_manufacture_year)
    else:
        record['x_vehicle_age'] = 0</field>
    </record>

    <record id="field_fleet_vehicle_x_replacement_policy_status" model="ir.model.fields">
        <field name="name">x_replacement_policy_status</field>
        <field name="field_description">Fleet Replacement Status</field>
        <field name="model_id" ref="fleet.model_fleet_vehicle"/>
        <field name="ttype">selection</field>
        <field name="state">manual</field>
        <field name="store">True</field>
        <field name="depends">x_vehicle_age,x_unit_classification</field>
        <field name="compute">for record in self:
    age = record.x_vehicle_age or 0
    classification = record.x_unit_classification or 'prime_mover'
    if classification == 'prime_mover':
        if age >= 18:
            record['x_replacement_policy_status'] = 'replace_due'
        elif age >= 17:
            record['x_replacement_policy_status'] = 'warning'
        else:
            record['x_replacement_policy_status'] = 'compliant'
    else:
        if age >= 15:
            record['x_replacement_policy_status'] = 'replace_due'
        elif age >= 14:
            record['x_replacement_policy_status'] = 'warning'
        else:
            record['x_replacement_policy_status'] = 'compliant'</field>
    </record>
