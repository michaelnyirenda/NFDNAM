<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_x_nfd_fuel_dispatch_log" model="ir.sequence">
        <field name="name">NFD Cargo Fuel Dispatch Reference</field>
        <field name="code">x_nfd_fuel_dispatch_log</field>
        <field name="prefix">DISP/%(year)s/</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

    <record id="seq_x_nfd_fuel_consumption_log" model="ir.sequence">
        <field name="name">NFD Refuel &amp; Odometer Log Reference</field>
        <field name="code">x_nfd_fuel_consumption_log</field>
        <field name="prefix">LOG/%(year)s/</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>
</odoo>
