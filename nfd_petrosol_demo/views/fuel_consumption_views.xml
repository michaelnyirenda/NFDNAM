<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. List / Tree View -->
    <record id="view_x_nfd_fuel_consumption_log_tree" model="ir.ui.view">
        <field name="name">x.nfd.fuel.consumption.log.list</field>
        <field name="model">x_nfd_fuel_consumption_log</field>
        <field name="arch" type="xml">
            <list string="Vehicle Refuel &amp; Odometer Logsheets (KM/L)"
                  decoration-danger="x_anomaly_flag in ('excess_burn', 'odo_error')"
                  decoration-warning="x_confirm_logsheet == 'unconfirmed'"
                  decoration-success="x_excess_use_liters &lt; 0">
                <field name="x_name"/>
                <field name="x_date"/>
                <field name="x_vehicle_id"/>
                <field name="x_driver_id"/>
                <field name="x_place"/>
                <field name="x_odometer_start" optional="hide"/>
                <field name="x_odometer_end" optional="hide"/>
                <field name="x_distance_traveled_km" sum="Total Distance (KM)"/>
                <field name="x_fuel_liters" sum="Total Fuel (L)"/>
                <field name="x_expected_km_per_liter"/>
                <field name="x_actual_km_per_liter"/>
                <field name="x_fuel_usage_difference"/>
                <field name="x_expected_fuel_liters" optional="show" sum="Expected Total Fuel (L)"/>
                <field name="x_excess_use_liters" sum="Total Excess (L)"/>
                <field name="x_nad_value" sum="Total Excess Value (NAD)"/>
                <field name="x_confirm_logsheet" widget="badge"
                       decoration-success="x_confirm_logsheet == 'confirmed'"
                       decoration-warning="x_confirm_logsheet == 'unconfirmed'"/>
                <field name="x_confirm_stock" widget="badge"
                       decoration-success="x_confirm_stock == 'confirmed'"
                       decoration-danger="x_confirm_stock == 'unconfirmed'"/>
                <field name="x_anomaly_flag" widget="badge"
                       decoration-success="x_anomaly_flag == 'normal'"
                       decoration-warning="x_anomaly_flag == 'excess_burn'"
                       decoration-danger="x_anomaly_flag == 'odo_error'"/>
                <field name="x_notes" optional="show"/>
            </list>
        </field>
    </record>

    <!-- 2. Form View -->
    <record id="view_x_nfd_fuel_consumption_log_form" model="ir.ui.view">
        <field name="name">x.nfd.fuel.consumption.log.form</field>
        <field name="model">x_nfd_fuel_consumption_log</field>
        <field name="arch" type="xml">
            <form string="Vehicle Refuel &amp; Odometer Logsheet">
                <header>
                    <field name="x_anomaly_flag" widget="statusbar"
                           statusbar_visible="normal,excess_burn,odo_error"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="ODOMETER / LOGSHEET ANOMALY" bg_color="text-bg-danger"
                            invisible="x_anomaly_flag != 'odo_error'"/>
                    <widget name="web_ribbon" title="EXCESS FUEL BURN" bg_color="text-bg-warning"
                            invisible="x_anomaly_flag != 'excess_burn'"/>
                    <widget name="web_ribbon" title="STAR FUEL SAVER" bg_color="text-bg-success"
                            invisible="x_excess_use_liters &gt;= 0"/>
                    <div class="oe_title">
                        <label for="x_name" string="Log Reference"/>
                        <h1>
                            <field name="x_name" placeholder="FCL/2026/0001"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Logsheet &amp; Odometer Details">
                            <field name="x_date"/>
                            <field name="x_vehicle_id"/>
                            <field name="x_driver_id"/>
                            <field name="x_place"/>
                            <field name="x_odometer_start"/>
                            <field name="x_odometer_end"/>
                            <field name="x_distance_traveled_km"/>
                        </group>
                        <group string="Fuel Consumption &amp; Otj COC Audit">
                            <field name="x_fuel_liters"/>
                            <field name="x_expected_km_per_liter"/>
                            <field name="x_actual_km_per_liter"/>
                            <field name="x_fuel_usage_difference"/>
                            <field name="x_expected_fuel_liters"/>
                            <field name="x_excess_use_liters"/>
                            <field name="x_otj_coc_fuel_price"/>
                            <field name="x_nad_value"/>
                        </group>
                    </group>
                    <group string="Internal Control &amp; Cross-Checks">
                        <group>
                            <field name="x_confirm_logsheet"/>
                            <field name="x_confirm_stock"/>
                        </group>
                        <group>
                            <field name="x_notes" placeholder="e.g. Walvis Bay haulage, manifold leak test, local errands..."/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- 3. Graph View: Excess Fuel Variance by Vehicle -->
    <record id="view_x_nfd_fuel_consumption_log_graph" model="ir.ui.view">
        <field name="name">x.nfd.fuel.consumption.log.graph</field>
        <field name="model">x_nfd_fuel_consumption_log</field>
        <field name="arch" type="xml">
            <graph string="Excess Fuel Liters &amp; Financial Impact (Otj COC)" type="bar" sample="1">
                <field name="x_vehicle_id"/>
                <field name="x_excess_use_liters" type="measure"/>
                <field name="x_nad_value" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- 3b. Graph View: Site & Corridor Refueling Analytics -->
    <record id="view_x_nfd_fuel_consumption_log_site_graph" model="ir.ui.view">
        <field name="name">x.nfd.fuel.consumption.log.site.graph</field>
        <field name="model">x_nfd_fuel_consumption_log</field>
        <field name="arch" type="xml">
            <graph string="Refueling Volume by Site &amp; Corridor (Liters)" type="bar" sample="1">
                <field name="x_place"/>
                <field name="x_fuel_liters" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- 4. Pivot Analysis -->
    <record id="view_x_nfd_fuel_consumption_log_pivot" model="ir.ui.view">
        <field name="name">x.nfd.fuel.consumption.log.pivot</field>
        <field name="model">x_nfd_fuel_consumption_log</field>
        <field name="arch" type="xml">
            <pivot string="Fuel Consumption &amp; Financial Loss Matrix" sample="1">
                <field name="x_vehicle_id" type="row"/>
                <field name="x_place" type="col"/>
                <field name="x_distance_traveled_km" type="measure"/>
                <field name="x_fuel_liters" type="measure"/>
                <field name="x_excess_use_liters" type="measure"/>
                <field name="x_nad_value" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- 5. Kanban View -->
    <record id="view_x_nfd_fuel_consumption_log_kanban" model="ir.ui.view">
        <field name="name">x.nfd.fuel.consumption.log.kanban</field>
        <field name="model">x_nfd_fuel_consumption_log</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_dashboard" sample="1">
                <field name="x_name"/>
                <field name="x_vehicle_id"/>
                <field name="x_driver_id"/>
                <field name="x_place"/>
                <field name="x_distance_traveled_km"/>
                <field name="x_fuel_liters"/>
                <field name="x_actual_km_per_liter"/>
                <field name="x_excess_use_liters"/>
                <field name="x_nad_value"/>
                <field name="x_anomaly_flag"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <strong class="o_kanban_record_title"><field name="x_name"/> - <field name="x_vehicle_id"/></strong>
                            <field name="x_anomaly_flag" widget="badge"
                                   decoration-warning="x_anomaly_flag == 'excess_burn'"
                                   decoration-danger="x_anomaly_flag == 'odo_error'"
                                   decoration-success="x_anomaly_flag == 'normal'"/>
                        </div>
                        <div class="o_kanban_record_body">
                            <div><strong>Driver:</strong> <field name="x_driver_id"/></div>
                            <div><strong>Place:</strong> <field name="x_place"/></div>
                            <div><strong>Distance:</strong> <field name="x_distance_traveled_km"/> km | <strong>Fuel:</strong> <field name="x_fuel_liters"/> L</div>
                            <div><strong>Efficiency:</strong> <field name="x_actual_km_per_liter"/> KM/L</div>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top">
                            <span class="fw-bold" invisible="x_excess_use_liters &lt;= 0" style="color: #dc3545;">
                                Excess: +<field name="x_excess_use_liters"/> L (NAD <field name="x_nad_value"/>)
                            </span>
                            <span class="fw-bold" invisible="x_excess_use_liters &gt; 0" style="color: #198754;">
                                Savings: <field name="x_excess_use_liters"/> L (NAD <field name="x_nad_value"/>)
                            </span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- 6. Search View -->
    <record id="view_x_nfd_fuel_consumption_log_search" model="ir.ui.view">
        <field name="name">x.nfd.fuel.consumption.log.search</field>
        <field name="model">x_nfd_fuel_consumption_log</field>
        <field name="arch" type="xml">
            <search string="Search Refuel &amp; Odometer Logs">
                <field name="x_name"/>
                <field name="x_vehicle_id"/>
                <field name="x_driver_id"/>
                <field name="x_place"/>
                <field name="x_notes"/>
                <separator/>
                <filter string="Unconfirmed Logsheets (X)" name="filter_unconfirmed_logsheet"
                        domain="[('x_confirm_logsheet', '=', 'unconfirmed')]"/>
                <filter string="Odometer / Audit Anomalies" name="filter_odo_anomalies"
                        domain="[('x_anomaly_flag', '=', 'odo_error')]"/>
                <filter string="Excess Fuel Burners (&gt;25L)" name="filter_excess_burners"
                        domain="[('x_excess_use_liters', '&gt;', 25.0)]"/>
                <filter string="Star Fuel Savers" name="filter_fuel_savers"
                        domain="[('x_excess_use_liters', '&lt;', 0.0)]"/>
                <group>
                    <filter string="Vehicle" name="group_vehicle" domain="[]" context="{'group_by': 'x_vehicle_id'}"/>
                    <filter string="Driver" name="group_driver" domain="[]" context="{'group_by': 'x_driver_id'}"/>
                    <filter string="Refueling Place" name="group_place" domain="[]" context="{'group_by': 'x_place'}"/>
                    <filter string="Audit Status" name="group_anomaly" domain="[]" context="{'group_by': 'x_anomaly_flag'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- 7. Action: All Refuel Logsheets -->
    <record id="action_nfd_fuel_consumption_log" model="ir.actions.act_window">
        <field name="name">Vehicle Odometer &amp; Refuel Logsheets (KM/L)</field>
        <field name="res_model">x_nfd_fuel_consumption_log</field>
        <field name="view_mode">list,kanban,graph,pivot,form</field>
        <field name="search_view_id" ref="view_x_nfd_fuel_consumption_log_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Record your first vehicle refueling &amp; odometer logsheet
            </p>
            <p>
                Track KM/L efficiency against expected targets, audit unconfirmed driver logsheets, and calculate excess fuel at Otj COC benchmark prices.
            </p>
        </field>
    </record>

    <!-- ============================================================== -->
    <!-- 8. DASHBOARD 1: NFD EXECUTIVE COMMAND CENTER                   -->
    <!-- ============================================================== -->
    <record id="action_nfd_dash_command_center" model="ir.actions.act_window">
        <field name="name">NFD Executive Command Center</field>
        <field name="res_model">x_nfd_fuel_consumption_log</field>
        <field name="view_mode">kanban,pivot,list,graph,form</field>
        <field name="view_id" ref="view_x_nfd_fuel_consumption_log_kanban"/>
        <field name="search_view_id" ref="view_x_nfd_fuel_consumption_log_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Executive Command Center: Refuel logs, driver audits, and variance tracking.
            </p>
        </field>
    </record>

    <!-- ============================================================== -->
    <!-- 9. DASHBOARD 2: FUEL CONSUMPTION & OTJ COC VARIANCE DASHBOARD  -->
    <!-- ============================================================== -->
    <record id="action_nfd_dash_fuel_variance" model="ir.actions.act_window">
        <field name="name">Fuel &amp; Otj COC Variance Dashboard</field>
        <field name="res_model">x_nfd_fuel_consumption_log</field>
        <field name="view_mode">graph,pivot,list,form</field>
        <field name="view_id" ref="view_x_nfd_fuel_consumption_log_graph"/>
        <field name="search_view_id" ref="view_x_nfd_fuel_consumption_log_search"/>
        <field name="context">{'search_default_group_vehicle': 1}</field>
    </record>

    <!-- ============================================================== -->
    <!-- 10. DASHBOARD 3: DRIVER & REFUELING SITE ANALYTICS             -->
    <!-- ============================================================== -->
    <record id="action_nfd_dash_driver_site" model="ir.actions.act_window">
        <field name="name">Driver &amp; Refueling Site Analytics</field>
        <field name="res_model">x_nfd_fuel_consumption_log</field>
        <field name="view_mode">graph,pivot,list,form</field>
        <field name="view_id" ref="view_x_nfd_fuel_consumption_log_site_graph"/>
        <field name="search_view_id" ref="view_x_nfd_fuel_consumption_log_search"/>
        <field name="context">{'search_default_group_place': 1}</field>
    </record>

    <!-- Backward-compatibility alias -->
    <record id="action_nfd_excess_fuel_dashboard" model="ir.actions.act_window">
        <field name="name">Fuel &amp; Otj COC Variance Dashboard</field>
        <field name="res_model">x_nfd_fuel_consumption_log</field>
        <field name="view_mode">graph,pivot,list,form</field>
        <field name="view_id" ref="view_x_nfd_fuel_consumption_log_graph"/>
        <field name="search_view_id" ref="view_x_nfd_fuel_consumption_log_search"/>
        <field name="context">{'search_default_group_vehicle': 1}</field>
    </record>
</odoo>
