<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="x_nfd_fuel_dispatch_log_view_list" model="ir.ui.view">
        <field name="name">x.nfd.fuel.dispatch.log.view.list</field>
        <field name="model">x_nfd_fuel_dispatch_log</field>
        <field name="arch" type="xml">
            <list string="Cargo Fuel Dispatch &amp; Leakage Logs"
                  decoration-danger="x_leakage_status == 'leakage_alert'"
                  decoration-warning="x_leakage_status == 'minor_variance'"
                  sample="1">
                <field name="x_name" decoration-bf="1"/>
                <field name="x_date"/>
                <field name="x_vehicle_id"/>
                <field name="x_driver_id"/>
                <field name="x_customer_id"/>
                <field name="x_fuel_product_id"/>
                <field name="x_depot_loaded_liters" sum="Total Loaded (L)"/>
                <field name="x_truck_meter_delivered_liters" sum="Total Delivered (L)"/>
                <field name="x_temp_allowance_liters" optional="show"/>
                <field name="x_net_variance_liters" sum="Total Variance (L)" decoration-danger="x_net_variance_liters &gt; 50"/>
                <field name="x_leakage_status" widget="badge"
                       decoration-danger="x_leakage_status == 'leakage_alert'"
                       decoration-warning="x_leakage_status == 'minor_variance'"
                       decoration-success="x_leakage_status == 'normal'"/>
                <field name="x_pre_trip_hse_passed" widget="boolean_toggle" optional="show"/>
                <field name="x_state" widget="badge"
                       decoration-info="x_state == 'in_transit'"
                       decoration-success="x_state == 'delivered'"
                       decoration-danger="x_state == 'investigation'"/>
                <field name="x_maintenance_request_id" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="x_nfd_fuel_dispatch_log_view_form" model="ir.ui.view">
        <field name="name">x.nfd.fuel.dispatch.log.view.form</field>
        <field name="model">x_nfd_fuel_dispatch_log</field>
        <field name="arch" type="xml">
            <form string="Cargo Fuel Dispatch Log">
                <header>
                    <button name="%(action_dispatch_tanker)d" string="Dispatch Tanker" type="action"
                            class="oe_highlight" invisible="x_state != 'draft'"/>
                    <button name="%(action_reconcile_delivery)d" string="Reconcile Delivery" type="action"
                            class="oe_highlight" invisible="x_state != 'in_transit'"/>
                    <button name="%(action_create_leakage_ticket)d"
                            string="Log Corrective Workshop Ticket &amp; Shrinkage Scrap"
                            type="action"
                            class="btn-danger oe_highlight"
                            invisible="x_leakage_status != 'leakage_alert' or x_maintenance_request_id"/>
                    <field name="x_state" widget="statusbar" statusbar_visible="draft,in_transit,delivered"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="LEAKAGE ALERT" bg_color="text-bg-danger"
                            invisible="x_leakage_status != 'leakage_alert'"/>
                    <widget name="web_ribbon" title="RECONCILED" bg_color="text-bg-success"
                            invisible="x_leakage_status != 'normal' or x_state != 'delivered'"/>

                    <div class="oe_title">
                        <span class="o_form_label">Dispatch Log Reference</span>
                        <h1>
                            <field name="x_name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Trip &amp; Vehicle Assignment">
                            <field name="x_date"/>
                            <field name="x_vehicle_id" options="{'no_create': True}"/>
                            <field name="x_driver_id" options="{'no_create': True}"/>
                            <field name="x_customer_id" options="{'no_create': True}"/>
                            <field name="x_fuel_product_id" options="{'no_create': True}"/>
                            <field name="x_compartment_seal_numbers" placeholder="e.g. NFD-SEAL-8891 to 8897"/>
                            <field name="x_pre_trip_hse_passed"/>
                        </group>
                        <group string="Volumetric Reconciliation (Liters)">
                            <field name="x_source_location_id"/>
                            <field name="x_destination_location_id"/>
                            <field name="x_depot_loaded_liters"/>
                            <field name="x_truck_meter_delivered_liters"/>
                            <field name="x_customer_dip_received_liters"/>
                            <field name="x_temp_allowance_liters"/>
                            <field name="x_net_variance_liters" decoration-danger="x_net_variance_liters &gt; 50"/>
                            <field name="x_leakage_status" widget="badge"
                                   decoration-danger="x_leakage_status == 'leakage_alert'"
                                   decoration-warning="x_leakage_status == 'minor_variance'"
                                   decoration-success="x_leakage_status == 'normal'"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Investigation &amp; Corrective Actions" name="investigation">
                            <group>
                                <group string="Otjiwarongo Workshop Ticket">
                                    <field name="x_maintenance_request_id" readonly="1"/>
                                </group>
                                <group string="Inventory Shrinkage Write-Off">
                                    <field name="x_scrap_id" readonly="1"/>
                                </group>
                            </group>
                            <group>
                                <field name="x_notes" placeholder="Detailed driver statements, dipstick discrepancies, or gantry calibration observations..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="x_nfd_fuel_dispatch_log_view_search" model="ir.ui.view">
        <field name="name">x.nfd.fuel.dispatch.log.view.search</field>
        <field name="model">x_nfd_fuel_dispatch_log</field>
        <field name="arch" type="xml">
            <search string="Search Dispatch Logs">
                <field name="x_name"/>
                <field name="x_vehicle_id"/>
                <field name="x_driver_id"/>
                <field name="x_customer_id"/>
                <field name="x_fuel_product_id"/>
                <filter string="Leakage Alerts (&gt;50L)" name="filter_leakage_alert"
                        domain="[('x_leakage_status', '=', 'leakage_alert')]"/>
                <filter string="Minor Variances" name="filter_minor_variance"
                        domain="[('x_leakage_status', '=', 'minor_variance')]"/>
                <filter string="Normal Deliveries" name="filter_normal"
                        domain="[('x_leakage_status', '=', 'normal')]"/>
                <separator/>
                <filter string="In Transit" name="filter_in_transit"
                        domain="[('x_state', '=', 'in_transit')]"/>
                <filter string="Delivered &amp; Reconciled" name="filter_delivered"
                        domain="[('x_state', '=', 'delivered')]"/>
                <filter string="Under HSE Investigation" name="filter_investigation"
                        domain="[('x_state', '=', 'investigation')]"/>
                <group>
                    <filter string="Receiving Customer" name="group_customer" domain="[]" context="{'group_by': 'x_customer_id'}"/>
                    <filter string="Vehicle" name="group_vehicle" domain="[]" context="{'group_by': 'x_vehicle_id'}"/>
                    <filter string="Driver" name="group_driver" domain="[]" context="{'group_by': 'x_driver_id'}"/>
                    <filter string="Fuel Product" name="group_product" domain="[]" context="{'group_by': 'x_fuel_product_id'}"/>
                    <filter string="Reconciliation Status" name="group_status" domain="[]" context="{'group_by': 'x_leakage_status'}"/>
                    <filter string="Dispatch Date" name="group_date" domain="[]" context="{'group_by': 'x_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="x_nfd_fuel_dispatch_log_view_kanban" model="ir.ui.view">
        <field name="name">x.nfd.fuel.dispatch.log.view.kanban</field>
        <field name="model">x_nfd_fuel_dispatch_log</field>
        <field name="arch" type="xml">
            <kanban default_group_by="x_state" sample="1">
                <field name="x_net_variance_liters"/>
                <field name="x_leakage_status"/>
                <templates>
                    <t t-name="card">
                        <main>
                            <div class="d-flex justify-content-between mb-2">
                                <strong class="o_kanban_record_title"><field name="x_name"/></strong>
                                <field name="x_leakage_status" widget="badge"
                                       decoration-danger="x_leakage_status == 'leakage_alert'"
                                       decoration-warning="x_leakage_status == 'minor_variance'"
                                       decoration-success="x_leakage_status == 'normal'"/>
                            </div>
                            <div class="text-muted mb-1">
                                <i class="fa fa-truck me-1" title="Vehicle"/> <field name="x_vehicle_id"/>
                            </div>
                            <div class="text-muted mb-1">
                                <i class="fa fa-user me-1" title="Driver"/> <field name="x_driver_id"/>
                            </div>
                            <div class="text-muted mb-1">
                                <i class="fa fa-map-marker me-1" title="Customer"/> <field name="x_customer_id"/>
                            </div>
                            <div class="d-flex justify-content-between mt-2 pt-2 border-top">
                                <span><field name="x_fuel_product_id"/></span>
                                <span class="fw-bold"><field name="x_depot_loaded_liters"/> L</span>
                            </div>
                            <div class="text-end text-danger small" invisible="x_net_variance_liters == 0">
                                Variance: <field name="x_net_variance_liters"/> L
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Pivot View -->
    <record id="x_nfd_fuel_dispatch_log_view_pivot" model="ir.ui.view">
        <field name="name">x.nfd.fuel.dispatch.log.view.pivot</field>
        <field name="model">x_nfd_fuel_dispatch_log</field>
        <field name="arch" type="xml">
            <pivot string="Bulk Fuel Dispatch &amp; Shrinkage Analysis" sample="1">
                <field name="x_customer_id" type="row"/>
                <field name="x_vehicle_id" type="row"/>
                <field name="x_fuel_product_id" type="col"/>
                <field name="x_depot_loaded_liters" type="measure"/>
                <field name="x_truck_meter_delivered_liters" type="measure"/>
                <field name="x_net_variance_liters" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Graph View -->
    <record id="x_nfd_fuel_dispatch_log_view_graph" model="ir.ui.view">
        <field name="name">x.nfd.fuel.dispatch.log.view.graph</field>
        <field name="model">x_nfd_fuel_dispatch_log</field>
        <field name="arch" type="xml">
            <graph string="Variance by Customer (Liters)" type="bar" sample="1">
                <field name="x_customer_id"/>
                <field name="x_net_variance_liters" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Action -->
    <record id="action_x_nfd_fuel_dispatch_log" model="ir.actions.act_window">
        <field name="name">Cargo Fuel Dispatch &amp; Leakage Logs</field>
        <field name="res_model">x_nfd_fuel_dispatch_log</field>
        <field name="view_mode">list,kanban,form,pivot,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Record your first Bulk Cargo Fuel Dispatch!
            </p>
            <p>
                Track bulk fuel loaded at Otjiwarongo Depot, compare against truck flow meter and customer dips,
                apply Namibian 0.25% thermal allowances, and automatically flag unexplainable discrepancies.
            </p>
        </field>
    </record>
</odoo>
